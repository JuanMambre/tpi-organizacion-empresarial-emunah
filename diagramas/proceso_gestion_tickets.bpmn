<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Def_Emunah" targetNamespace="http://bpmn.io/schema/bpmn" exporter="TPI Organizacion Empresarial" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Emunah">
    <bpmn:participant id="P_banco" name="Banco cliente" processRef="Proc_banco" />
    <bpmn:participant id="P_emunah" name="Emunah – Gestión de tickets con el módulo inteligente" processRef="Proc_emunah" />
    <bpmn:messageFlow id="mf1" name="Solicitud / incidente" sourceRef="b_rep" targetRef="e_start" />
    <bpmn:messageFlow id="mf2" name="Notificación de resolución" sourceRef="pm_close" targetRef="b_wait" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_banco" isExecutable="false">
    <bpmn:startEvent id="b_start" name="Necesidad o incidente detectado"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="b_rep" name="Reportar incidente o solicitud"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
    <bpmn:intermediateCatchEvent id="b_wait" name="Notificación recibida"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing><bpmn:messageEventDefinition id="b_wait_med" /></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="b_end" name="Requerimiento resuelto"><bpmn:incoming>f3</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="b_start" targetRef="b_rep" />
    <bpmn:sequenceFlow id="f2" sourceRef="b_rep" targetRef="b_wait" />
    <bpmn:sequenceFlow id="f3" sourceRef="b_wait" targetRef="b_end" />
  </bpmn:process>
  <bpmn:process id="Proc_emunah" isExecutable="false">
    <bpmn:laneSet id="LS_emunah">
      <bpmn:lane id="L_pm" name="Project Manager"><bpmn:flowNodeRef>e_start</bpmn:flowNodeRef><bpmn:flowNodeRef>pm_prio</bpmn:flowNodeRef><bpmn:flowNodeRef>pm_close</bpmn:flowNodeRef><bpmn:flowNodeRef>e_end</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_coord" name="Coordinador de Desarrollo"><bpmn:flowNodeRef>c_rev</bpmn:flowNodeRef><bpmn:flowNodeRef>g2</bpmn:flowNodeRef><bpmn:flowNodeRef>gm1</bpmn:flowNodeRef><bpmn:flowNodeRef>c_man</bpmn:flowNodeRef><bpmn:flowNodeRef>g2m</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_mod" name="Módulo inteligente (sistema)"><bpmn:flowNodeRef>m_anal</bpmn:flowNodeRef><bpmn:flowNodeRef>g1</bpmn:flowNodeRef><bpmn:flowNodeRef>m_rel</bpmn:flowNodeRef><bpmn:flowNodeRef>m_sug</bpmn:flowNodeRef><bpmn:flowNodeRef>m_notif</bpmn:flowNodeRef><bpmn:flowNodeRef>lk_out</bpmn:flowNodeRef><bpmn:flowNodeRef>m_hrs</bpmn:flowNodeRef><bpmn:flowNodeRef>m_reg</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_dev" name="Desarrollador"><bpmn:flowNodeRef>lk_in</bpmn:flowNodeRef><bpmn:flowNodeRef>g_loop</bpmn:flowNodeRef><bpmn:flowNodeRef>d_dev</bpmn:flowNodeRef><bpmn:flowNodeRef>d_revh</bpmn:flowNodeRef><bpmn:flowNodeRef>g4</bpmn:flowNodeRef><bpmn:flowNodeRef>d_corr</bpmn:flowNodeRef><bpmn:flowNodeRef>g4m</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_qa" name="QA / Testing"><bpmn:flowNodeRef>q_test</bpmn:flowNodeRef><bpmn:flowNodeRef>g3</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="e_start" name="Ticket ingresado en Jira"><bpmn:outgoing>f4</bpmn:outgoing><bpmn:messageEventDefinition id="e_start_med" /></bpmn:startEvent>
    <bpmn:userTask id="pm_prio" name="Revisar y priorizar el ticket"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="m_anal" name="Analizar ticket con historial de Jira y perfiles técnicos"><bpmn:incoming>f5</bpmn:incoming><bpmn:outgoing>f6</bpmn:outgoing><bpmn:property id="m_anal_prop" name="__targetRef_placeholder" /><bpmn:dataInputAssociation id="da_in"><bpmn:sourceRef>ds_jira</bpmn:sourceRef><bpmn:targetRef>m_anal_prop</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="¿Información suficiente?"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m_rel" name="Detectar tickets relacionados"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="m_sug" name="Generar sugerencia de asignación"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="c_rev" name="Revisar sugerencia del módulo"><bpmn:incoming>f10</bpmn:incoming><bpmn:outgoing>f11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="¿Acepta la sugerencia?"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing><bpmn:outgoing>f13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gm1"><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="c_man" name="Asignar desarrollador manualmente y registrar motivo"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g2m"><bpmn:incoming>f13</bpmn:incoming><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m_notif" name="Notificar asignación y alertar conflictos"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="lk_out" name="A"><bpmn:incoming>f17</bpmn:incoming><bpmn:linkEventDefinition id="lk_out_led" name="A" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="lk_in" name="A"><bpmn:outgoing>f18</bpmn:outgoing><bpmn:linkEventDefinition id="lk_in_led" name="A" /></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="g_loop"><bpmn:incoming>f18</bpmn:incoming><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="d_dev" name="Desarrollar la solución"><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="q_test" name="Probar la solución"><bpmn:incoming>f20</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="¿Supera las pruebas?"><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing><bpmn:outgoing>f23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m_hrs" name="Generar propuesta de horas y resumen diario"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f24</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="d_revh" name="Revisar propuesta de horas"><bpmn:incoming>f24</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4" name="¿Propuesta correcta?"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:outgoing>f27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="d_corr" name="Corregir horas propuestas"><bpmn:incoming>f27</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g4m"><bpmn:incoming>f26</bpmn:incoming><bpmn:incoming>f28</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="m_reg" name="Registrar horas y actualizar perfil técnico"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing><bpmn:dataOutputAssociation id="da_out"><bpmn:targetRef>ds_mod</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
    <bpmn:userTask id="pm_close" name="Cerrar ticket y comunicar la resolución"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e_end" name="Ticket cerrado"><bpmn:incoming>f31</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_jira" name="Jira (tickets e historial)" />
    <bpmn:dataStoreReference id="ds_mod" name="Base del módulo (horas y perfiles)" />
    <bpmn:sequenceFlow id="f4" sourceRef="e_start" targetRef="pm_prio" />
    <bpmn:sequenceFlow id="f5" sourceRef="pm_prio" targetRef="m_anal" />
    <bpmn:sequenceFlow id="f6" sourceRef="m_anal" targetRef="g1" />
    <bpmn:sequenceFlow id="f7" name="Sí" sourceRef="g1" targetRef="m_rel" />
    <bpmn:sequenceFlow id="f8" name="No" sourceRef="g1" targetRef="gm1" />
    <bpmn:sequenceFlow id="f9" sourceRef="m_rel" targetRef="m_sug" />
    <bpmn:sequenceFlow id="f10" sourceRef="m_sug" targetRef="c_rev" />
    <bpmn:sequenceFlow id="f11" sourceRef="c_rev" targetRef="g2" />
    <bpmn:sequenceFlow id="f12" name="No" sourceRef="g2" targetRef="gm1" />
    <bpmn:sequenceFlow id="f13" name="Sí" sourceRef="g2" targetRef="g2m" />
    <bpmn:sequenceFlow id="f14" sourceRef="gm1" targetRef="c_man" />
    <bpmn:sequenceFlow id="f15" sourceRef="c_man" targetRef="g2m" />
    <bpmn:sequenceFlow id="f16" sourceRef="g2m" targetRef="m_notif" />
    <bpmn:sequenceFlow id="f17" sourceRef="m_notif" targetRef="lk_out" />
    <bpmn:sequenceFlow id="f18" sourceRef="lk_in" targetRef="g_loop" />
    <bpmn:sequenceFlow id="f19" sourceRef="g_loop" targetRef="d_dev" />
    <bpmn:sequenceFlow id="f20" sourceRef="d_dev" targetRef="q_test" />
    <bpmn:sequenceFlow id="f21" sourceRef="q_test" targetRef="g3" />
    <bpmn:sequenceFlow id="f22" name="No" sourceRef="g3" targetRef="g_loop" />
    <bpmn:sequenceFlow id="f23" name="Sí" sourceRef="g3" targetRef="m_hrs" />
    <bpmn:sequenceFlow id="f24" sourceRef="m_hrs" targetRef="d_revh" />
    <bpmn:sequenceFlow id="f25" sourceRef="d_revh" targetRef="g4" />
    <bpmn:sequenceFlow id="f26" name="Sí" sourceRef="g4" targetRef="g4m" />
    <bpmn:sequenceFlow id="f27" name="No" sourceRef="g4" targetRef="d_corr" />
    <bpmn:sequenceFlow id="f28" sourceRef="d_corr" targetRef="g4m" />
    <bpmn:sequenceFlow id="f29" sourceRef="g4m" targetRef="m_reg" />
    <bpmn:sequenceFlow id="f30" sourceRef="m_reg" targetRef="pm_close" />
    <bpmn:sequenceFlow id="f31" sourceRef="pm_close" targetRef="e_end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_Emunah">
      <bpmndi:BPMNShape id="P_banco_di" bpmnElement="P_banco" isHorizontal="true"><dc:Bounds x="20" y="20" width="3550" height="140" /></bpmndi:BPMNShape>
